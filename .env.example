# Database connection
# Local dev (SQLite): sqlite:///./jobtracker.db
# Local Postgres:     postgresql+psycopg://appuser:apppassword@localhost:5432/jobtracker
# Docker Compose:     postgresql+psycopg://appuser:apppassword@db:5432/jobtracker
DATABASE_URL=postgresql+psycopg://appuser:apppassword@localhost:5432/jobtracker

# Generate a strong one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-this-with-a-long-random-key

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60